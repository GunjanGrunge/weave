rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsBook(bookId) {
      return request.auth != null
        && request.auth.uid == get(
          /databases/$(database)/documents/books/$(bookId)
        ).data.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /books/{bookId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow write: if false;

      match /chapters/{chapterId} {
        allow read: if ownsBook(bookId);
        allow write: if false;

        match /scenes/{sceneId} {
          allow read: if ownsBook(bookId);
          allow write: if false;
        }
      }

      match /messages/{messageId} {
        allow read: if ownsBook(bookId);
        allow write: if false;
      }

      match /vision/{visionId} {
        allow read: if ownsBook(bookId);
        allow write: if false;
      }

      match /facts/{factId} {
        allow read: if ownsBook(bookId);
        allow write: if false;
      }

      match /usage/{usageId} {
        allow read: if ownsBook(bookId);
        allow write: if false;
      }

      match /snapshots/{snapshotId} {
        allow read: if ownsBook(bookId);
        allow write: if false;
      }

      // sessions, generationRequests, system state, and any unknown nested
      // collections remain denied by the global rule above.
    }
  }
}
