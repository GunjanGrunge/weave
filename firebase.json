{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".output/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/health",
        "function": {
          "functionId": "health",
          "region": "us-central1"
        }
      },
      {
        "source": "/whoami",
        "function": {
          "functionId": "whoami",
          "region": "us-central1"
        }
      },
      {
        "source": "/listBooks",
        "function": {
          "functionId": "listBooks",
          "region": "us-central1"
        }
      },
      {
        "source": "/createBook",
        "function": {
          "functionId": "createBook",
          "region": "us-central1"
        }
      },
      {
        "source": "/createChapter",
        "function": {
          "functionId": "createChapter",
          "region": "us-central1"
        }
      },
      {
        "source": "/retryOpeningSuggestion",
        "function": {
          "functionId": "retryOpeningSuggestion",
          "region": "us-central1"
        }
      },
      {
        "source": "/getVision",
        "function": {
          "functionId": "getVision",
          "region": "us-central1"
        }
      },
      {
        "source": "/updateVision",
        "function": {
          "functionId": "updateVision",
          "region": "us-central1"
        }
      },
      {
        "source": "/getMessages",
        "function": {
          "functionId": "getMessages",
          "region": "us-central1"
        }
      },
      {
        "source": "/generateScene",
        "function": {
          "functionId": "generateScene",
          "region": "us-central1"
        }
      },
      {
        "source": "/saveGeneratedScene",
        "function": {
          "functionId": "saveGeneratedScene",
          "region": "us-central1"
        }
      },
      {
        "source": "/regenerateScene",
        "function": {
          "functionId": "regenerateScene",
          "region": "us-central1"
        }
      },
      {
        "source": "/revertGeneratedScene",
        "function": {
          "functionId": "revertGeneratedScene",
          "region": "us-central1"
        }
      },
      {
        "source": "/acceptScene",
        "function": {
          "functionId": "acceptScene",
          "region": "us-central1"
        }
      },
      {
        "source": "/getStyleConfig",
        "function": {
          "functionId": "getStyleConfig",
          "region": "us-central1"
        }
      },
      {
        "source": "/updateBookStyle",
        "function": {
          "functionId": "updateBookStyle",
          "region": "us-central1"
        }
      },
      {
        "source": "/saveSnapshot",
        "function": {
          "functionId": "saveSnapshot",
          "region": "us-central1"
        }
      },
      {
        "source": "/listSnapshots",
        "function": {
          "functionId": "listSnapshots",
          "region": "us-central1"
        }
      },
      {
        "source": "/compareSnapshot",
        "function": {
          "functionId": "compareSnapshot",
          "region": "us-central1"
        }
      },
      {
        "source": "/restoreSnapshot",
        "function": {
          "functionId": "restoreSnapshot",
          "region": "us-central1"
        }
      },
      {
        "source": "/exportBook",
        "function": {
          "functionId": "exportBook",
          "region": "us-central1"
        }
      },
      {
        "source": "/deleteBook",
        "function": {
          "functionId": "deleteBook",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "runtime": "nodejs22",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"],
      "predeploy": ["npm --prefix functions run verify"]
    }
  ]
}
