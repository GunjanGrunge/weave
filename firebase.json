{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".output/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/health",
        "function": {
          "functionId": "health",
          "region": "us-central1"
        }
      },
      {
        "source": "/whoami",
        "function": {
          "functionId": "whoami",
          "region": "us-central1"
        }
      },
      {
        "source": "/createBook",
        "function": {
          "functionId": "createBook",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "runtime": "nodejs22",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"],
      "predeploy": ["npm --prefix functions run verify"]
    }
  ]
}
